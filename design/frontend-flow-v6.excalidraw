                     {
                         "id":  "q234-coupling-options",
                         "type":  "text",
                         "x":  910,
                         "y":  1345,
                         "width":  700,
                         "height":  127.5,
                         "angle":  0,
                         "strokeColor":  "#1e1e1e",
