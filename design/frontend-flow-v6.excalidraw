                         "x":  910,
                         "y":  1115,
                         "width":  700,
                         "height":  76.5,
                         "angle":  0,
                         "strokeColor":  "#1e1e1e",
                         "backgroundColor":  "transparent",
                         "fillStyle":  "solid",
                         "strokeWidth":  1,
                         "strokeStyle":  "solid",
                         "roughness":  0,
                         "opacity":  100,
                         "groupIds":  [

