{
  "name": "safeangle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepare:pose": "node scripts/prepare-pose.mjs",
    "engine:dev": "node scripts/dev-engine.mjs",
    "prepare:fixtures": "node scripts/prepare-fixtures.mjs",
    "engine:verify": "node scripts/verify-browser.cjs",
    "reba:verify": "node scripts/verify-reba-browser.cjs",
    "vision:dev": "node --experimental-strip-types server/start.ts",
    "vision:verify": "node --experimental-strip-types scripts/verify-vlm-browser.cjs"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "playwright": "1.62.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.34"
  }
}
